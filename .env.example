# Public (browser-side) Supabase credentials — used by src/lib/supabaseClient.ts
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service-role key — used ONLY by scripts/seed.ts (never exposed to the browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server-side only — used by src/app/api/extract-store/route.ts (Vision AI "Smart Add")
ANTHROPIC_API_KEY=your-anthropic-api-key

# One-off script only — used by scripts/geocode_google.py for precise street-level
# geocoding (Google Cloud Console → APIs & Services → enable "Geocoding API")
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
